# ── Public (safe in the browser) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://manakosamu.com

# ── Server only (never prefix with NEXT_PUBLIC_) ──────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret between pg_cron / admin "Run sync" and the sync Edge Functions
CRON_SECRET=generate-a-long-random-string
# Optional: Telugu AI summary ("తెలుగులో అర్థం చేసుకోండి")
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-haiku-5-5
# Smart search + "Ask AI" (docs/AI.md). Embeddings: Voyage (default) or OpenAI; answers: ANTHROPIC_API_KEY above.
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDINGS_PROVIDER=voyage        # or openai
# EMBEDDINGS_MODEL=                 # must output 1024 dimensions
# AI_ASSISTANT_MODEL=claude-haiku-5-5
# SMART_SEARCH=off / AI_ASSISTANT=off to switch either off
# Optional: Startup Jobs MCP key (only after terms review; set as an Edge Function secret too)
STARTUP_JOBS_API_KEY=
# Optional extra sources (set the same values as Edge Function secrets; sources stay disabled until enabled in /admin/jobs)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FREELANCER_OAUTH_TOKEN=
# Jooble (India part-time / WFH / fresher jobs): free key from https://jooble.org/api/about
JOOBLE_API_KEY=

# Leave NEXT_PUBLIC_SUPABASE_URL empty to run in DEMO MODE with bundled sample jobs.

# Affiliate tracking links (optional; links saved in /admin/jobs/affiliates take priority).
# One per partner slug — see docs/AFFILIATES.md. Must be https.
# AFFILIATE_URL_FIVERR=
# AFFILIATE_URL_UPWORK=
# AFFILIATE_URL_COURSERA=
# AFFILIATE_URL_UDEMY=
# AFFILIATE_URL_PAYONEER=

# Careerjet "More jobs" box on /jobs/search (publisher key from careerjet.co.in → Partners; pays per click).
# Without a key only a button that opens Careerjet's search is shown. CAREERJET=off hides the box.
CAREERJET_API_KEY=
# CAREERJET=off

# ── Subscription app ─────────────────────────────────────────────
# "subscription" (default): jobs need mobile-OTP sign-in, one registered device, and a trial/plan.
# "open": free public site. Also set the same mode in /admin/subscribers (database setting).
ACCESS_MODE=subscription
# Email + password sign-in (testing): on | off. Unset = follow the switch in /admin/subscribers.
# EMAIL_LOGIN=on
# Signs the short-lived access cookie (any long random string, server only).
ACCESS_COOKIE_SECRET=
# Razorpay (Dashboard → Account & Settings → API keys / Webhooks). Server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shown on /contact and /refunds (Razorpay requires these pages).
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ── AapStack (OwnDatabase) instead of Supabase ───────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://aapstack.tech/p/<project id>     (supabase-js works unchanged)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=odb_anon_…
# SUPABASE_SERVICE_ROLE_KEY=odb_svc_…
# Deploy (npm run aapstack:deploy) also needs a personal access token:
# ODB_TOKEN=odb_pat_…
