# ── Public (safe in the browser) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://manakosamu.com

# ── Server only (never prefix with NEXT_PUBLIC_) ──────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret between pg_cron / admin "Run sync" and the sync Edge Functions
CRON_SECRET=generate-a-long-random-string
# Optional: Telugu AI summary ("తెలుగులో అర్థం చేసుకోండి")
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-haiku-5-5
# Optional: Startup Jobs MCP key (only after terms review; set as an Edge Function secret too)
STARTUP_JOBS_API_KEY=
# Optional extra sources (set the same values as Edge Function secrets; sources stay disabled until enabled in /admin/jobs)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FREELANCER_OAUTH_TOKEN=

# Leave NEXT_PUBLIC_SUPABASE_URL empty to run in DEMO MODE with bundled sample jobs.
